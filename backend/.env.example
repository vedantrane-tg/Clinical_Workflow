# Backend environment (copy to backend/.env and fill values)

# Google / Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Deepgram (optional — scribe falls back if missing)
# DEEPGRAM_API_KEY=

# JWT
# JWT_SECRET=change-me-to-a-random-64-char-string
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_MINUTES=480

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
# Leave blank to disable Card/UPI gateway (Cash/Insurance still work).
# RAZORPAY_KEY_ID=rzp_test_TcehgihToN7p2i 
# RAZORPAY_KEY_SECRET=4jv3y3GRmJNxePG1GMGtrR9X
# Optional — for /payments/razorpay/webhook
# RAZORPAY_WEBHOOK_SECRET=
